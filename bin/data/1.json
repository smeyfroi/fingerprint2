{
  "version": "1.0",
  "name": "Simple 1",
  "description": "Audio data with clusters visualised as points. Two quiet intents.",
  
  "drawingLayers": {
    "foreground": {
      "size": [2400, 2400],
      "internalFormat": "GL_RGBA32F",
      "wrap": "GL_CLAMP_TO_EDGE",
      "clearOnUpdate": false,
      "blendMode": "OF_BLENDMODE_ALPHA",
      "useStencil": false,
      "numSamples": 0,
      "isDrawn": true
    },
    "fluid_velocity": {
      "size": [1200, 1200],
      "internalFormat": "GL_RG32F",
      "wrap": "GL_REPEAT",
      "clearOnUpdate": false,
      "blendMode": "OF_BLENDMODE_DISABLED",
      "useStencil": false,
      "numSamples": 0,
      "isDrawn": false
    }
  },

  "mods": {
    "TitleText": {
      "type": "StaticTextSource",
      "config": {
        "Text": "Void",
        "EmitOnce": "1",
        "Delay": "0"
      }
    },
    "Title": {
      "type": "Text",
      "_requires": "ResourceManager with 'fontPath'",
      "config": {
        "Position": "0.5, 0.5",
        "FontSize": "0.1",
        "Colour": "1, 1, 1, 1",
        "Alpha": "1",
        "AgencyFactor": "1"
      },
      "layers": {
        "default": ["foreground"]
      }
    },
    "Audio": {
      "type": "AudioDataSource",
      "config": {
        "MinPitch": "50.0",
        "MaxPitch": "400.0",
        "MinRms": "0.0005",
        "MaxRms": "0.01"
      }
    },
    "Cluster": {
      "type": "Cluster"
    },
    "Random Color": {
      "type": "RandomHslColor",
      "config": {
        "CreatedPerUpdate": "0.2"
      }
    },
    "Random Radius": {
      "type": "RandomFloatSource",
      "config": {
        "CreatedPerUpdate": "0.5",
        "Min": "0.001",
        "Max": "0.01"
      }
    },
    "Point": {
      "type": "SoftCircle",
      "config": {
        "Colour": "0.3,0.2,0.5,0.2",
        "ColourMultiplier": "0.5",
        "AlphaMultiplier": "1.0",
        "Softness": "1.0"
      },
      "layers": {
        "default": ["foreground"]
      }
    },
    "Random Impulse Point": {
      "type": "RandomVecSource",
      "config": {
        "CreatedPerUpdate": "0.1"
      }
    },
    "Impulse": {
      "type": "FluidRadialImpulse",
      "config": {
        "Impulse Radius": "0.15",
        "Impulse Strength": "0.2"
      },
      "layers": {
        "default": ["fluid_velocity"]
      }
    },
    "Fluid": {
      "type": "Fluid",
      "config": {
        "dt": "0.005"
      },
      "layers": {
        "default": ["foreground"],
        "velocities": ["fluid_velocity"]
      }
    }
  },
  
  "connections": [
    "Audio.PitchRmsPoint -> Cluster.Point",
    "Random Color.Vec4 -> Point.Colour",
    "Random Radius.Float -> Point.Radius",
    "Cluster.ClusterCentre -> Point.Point",
    "Random Impulse Point.Vec2 -> Impulse.Point"
  ],
  
  "intents": {
    "Void": {
      "energy": 0.1,
      "density": 0.1,
      "structure": 0.3,
      "chaos": 0.0,
      "granularity": 0.1
    },
    "SignOfLife": {
      "energy": 0.3,
      "density": 0.1,
      "structure": 0.5,
      "chaos": 0.7,
      "granularity": 0.1
    }
  }
}

